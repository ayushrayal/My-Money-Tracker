# =============================================================================
# My Money Tracker — Environment Configuration Reference (Root / Deployment)
# =============================================================================
#
# Copy this file or the respective client/.env.example and server/.env.example
# into their corresponding .env files for local development.

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=

# Authentication & Session Security
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS Configuration
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Client Configuration
# Leave empty for local development (uses Vite proxy to http://localhost:5001)
# Set to remote API URL when deploying to static hosting
VITE_API_URL=
