# Server Network Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & Session Security
# Generate a secure 32+ character secret: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Cookie Security Configuration
# Set to 'true' in production (HTTPS required)
COOKIE_SECURE=false
# 'lax' for local dev and same-site reverse proxy; 'none' if client and server are on separate domains in production
COOKIE_SAME_SITE=lax

# CORS Configuration - comma-separated list of allowed origins (never '*' when credentials: true)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
